# --- Turo Role Coach: local settings. Copy to .env. Never commit .env. ---
PORT=3000

# ElevenLabs agent (role-agnostic "Turo Role Coach – Universal"); auth must be OFF on the agent
ELEVENLABS_AGENT_ID=agent_2401m4x3htaxe3gr17aarh8enb5c
# Must match the agent's TTS output format (Voice tab). Currently PCM 16000 Hz.
AGENT_SAMPLE_RATE=16000

# Spatius values (app id, API key, avatar id, region) live in public/coach-config.js, not here.

# Content: leave blank to read ./content, or point at Azure Blob, e.g.
# CONTENT_BASE_URL=https://<account>.blob.core.windows.net/role-coach
# CONTENT_SAS=sv=...&sig=...
CONTENT_BASE_URL=

# 1 = UI only, no avatar/voice (for layout review)
MOCK_MODE=0
