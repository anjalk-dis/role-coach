# --- Turo Role Coach: local secrets. Never commit this file. ---
PORT=3000

# LiveAvatar (HeyGen)
LIVEAVATAR_API_KEY=your-liveavatar-api-key
# Set with: node scripts/list-avatars.mjs <avatarId>
LIVEAVATAR_AVATAR_ID=0930fd59-c8ad-434d-ad53-b391a1768720
# 1 = sandbox (free test sessions, if your plan supports it)
LIVEAVATAR_SANDBOX=0
VIDEO_QUALITY=high
# MAX_SESSION_SECONDS=600

# ElevenLabs agent (role-agnostic "Turo Role Coach – Universal")
ELEVENLABS_AGENT_ID=agent_2401m4x3htaxe3gr17aarh8enb5c
# Set with: node scripts/setup-elevenlabs-secret.mjs <ELEVENLABS_API_KEY>
ELEVENLABS_SECRET_ID=your-elevenlabs-secret-id

# Content: leave blank to read ./content, or point at Azure Blob, e.g.
# CONTENT_BASE_URL=https://<account>.blob.core.windows.net/role-coach
# CONTENT_SAS=sv=...&sig=...
CONTENT_BASE_URL=

# 1 = UI only, no avatar/voice (for layout review)
MOCK_MODE=0
