# Must match the agent's TTS output format (Voice tab). Currently PCM 16000 Hz.
AGENT_SAMPLE_RATE=16000

# Spatius (Spatius Studio → Apps / Avatar Library)
SPATIUS_APP_ID=app_muu2ql83_18ab6ne
